{
    "name": "app/inventory-management",
    "description": "Inventory Management System using Phalcon 5",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phalcon/ide-stubs": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\Controllers\\Web\\": "app/controllers/Web/",
            "App\\Controllers\\Api\\": "app/controllers/Api/",
            "App\\Models\\": "app/models/",
            "App\\Services\\": "app/services/",
            "App\\Validators\\": "app/validators/",
            "App\\Middleware\\": "app/middleware/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
